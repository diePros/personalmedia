# Copy to `.env` (same folder as docker-compose.yml) and edit. `.env` is not
# tracked by git, so updates with `git pull` keep your settings.

# Required: your public Funnel URL.
PM_PUBLIC_URL=https://<node>.<tailnet>.ts.net

# Host folder for the encrypted data (owned by uid/gid 10001).
DATA_DIR=/DATA/AppData/personal-media

# Image tag: `latest`, or pin a version such as `1.6`.
IMAGE_TAG=latest

# Container memory limit.
MEM_LIMIT=1536m

# Largest upload in MB.
PM_MAX_UPLOAD_MB=100

# Optional: iCloud link of the PMS Shortcut (Settings → iPhone setup).
# PM_IOS_SHORTCUT_URL=https://www.icloud.com/shortcuts/<32 hex chars>

# Optional, see docs/setup.md for all settings, e.g.:
# PM_SESSION_IDLE_MINUTES=30
# PM_SESSION_MAX_HOURS=12
